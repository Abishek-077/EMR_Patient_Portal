{
  "name": "emr-patient-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch backend/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run check:backend",
    "format:check": "git diff --check",
    "check:backend": "node backend/scripts/check-syntax.js",
    "build": "npm run typecheck && vite build",
    "test": "npm run format:check && npm run lint && npm run test:unit && npm run build && npm run test:api && npm run test:security && npm run test:migration",
    "test:unit": "node backend/scripts/unit-test.js",
    "test:api": "node backend/scripts/smoke-test.js",
    "test:security": "node backend/scripts/security-regression-test.js",
    "test:migration": "node backend/scripts/migration-test.js",
    "test:ux": "npm run seed:demo && playwright test frontend/tests/ux-evidence.spec.ts",
    "test:ux:evidence": "npm run test:ux",
    "reset:demo": "node backend/scripts/reset-demo-data.js",
    "seed:demo": "node backend/scripts/seed-demo-users.js",
    "migrate:legacy": "node backend/scripts/migrate-legacy-data.js",
    "seed:admin": "node backend/scripts/create-admin.js",
    "start": "node backend/index.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.60.0",
    "@carbon/react": "^1.85.0",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.0",
    "sass": "^1.91.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
