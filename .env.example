# API runtime
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
API_BASE_PATH=/api
SESSION_SECRET=replace-this-with-a-long-random-secret
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_HOURS=168
MAX_SESSIONS_PER_USER=10
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local persistence and provider adapters
EMR_DB_PATH=./data/emr.sqlite
EMR_UPLOAD_DIR=./data/uploads
PAYMENT_PROVIDER=local
NOTIFICATION_PROVIDER=local
FILE_STORAGE_PROVIDER=local
CLINICAL_PROVIDER=local
DRUG_INTERACTION_PROVIDER=local

# Frontend: leave empty for same-origin Express/Vite proxy deployment
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
VITE_HOST=127.0.0.1
VITE_PORT=5173
